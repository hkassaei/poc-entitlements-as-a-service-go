# Server
PORT=8443
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://ecs:password@localhost:5432/entitlements
DB_POOL_SIZE=5

# Redis
REDIS_URL=redis://localhost:6379

# Mock HSS
HSS_URL=http://mock-hss:3001

# Token Settings
AUTH_TOKEN_TTL_SECONDS=86400
FAST_AUTH_TOKEN_TTL_SECONDS=172800
TEMP_TOKEN_TTL_SECONDS=3600

# Ki Encryption (Envelope Encryption)
KMS_KEY_RING=entitlement-keys
KMS_KEY_NAME=ki-kek
KMS_LOCATION=us-central1
LOCAL_KEK_HEX=

# Protocol
SUPPORTED_VERSIONS=2,4
DEFAULT_CONFIG_VALIDITY=172800

# Operator Identity
OPERATOR_MCC=001
OPERATOR_MNC=01
OPERATOR_NAME=TestOperator

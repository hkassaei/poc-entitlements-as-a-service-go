{
  "name": "entitlements-as-a-service",
  "version": "0.1.0",
  "description": "Telecommunications entitlement server implementing GSMA TS.43 EAP-AKA authentication",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed-entitlements": "tsx src/db/seed-entitlements.ts",
    "lint": "eslint src/ tests/"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.1.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.211.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.211.0",
    "@opentelemetry/instrumentation-http": "^0.211.0",
    "@opentelemetry/instrumentation-ioredis": "^0.59.0",
    "@opentelemetry/instrumentation-pg": "^0.63.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-metrics": "^2.5.0",
    "@opentelemetry/sdk-node": "^0.211.0",
    "@opentelemetry/sdk-trace-node": "^2.5.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^10.0.0",
    "typebox": "^1.0.0"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.2.1",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.39.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.0"
  }
}

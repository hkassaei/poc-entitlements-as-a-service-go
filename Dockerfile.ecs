# Multi-stage build for ECS server
FROM golang:1.24-bookworm AS builder

WORKDIR /app

# Cache dependency downloads
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY sql/ ./sql/

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /ecs ./cmd/ecs

# Runtime image — distroless for minimal attack surface
FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /ecs /ecs
COPY sql/schema.sql /sql/schema.sql

EXPOSE 8443

ENTRYPOINT ["/ecs"]
